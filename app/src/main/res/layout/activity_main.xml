<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mi Robot AI — Motor Test"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Not connected"
            android:textSize="16sp" />

        <Button
            android:id="@+id/scanButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="1. Scan for robot" />

        <ListView
            android:id="@+id/deviceList"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Hold a direction button to move. Release it to stop. Keep the wheels off the floor for the first test."
            android:textSize="14sp" />

        <Button
            android:id="@+id/forwardButton"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:text="▲ Forward" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/leftButton"
                android:layout_width="130dp"
                android:layout_height="wrap_content"
                android:text="◀ Left" />

            <Button
                android:id="@+id/stopButton"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="STOP" />

            <Button
                android:id="@+id/rightButton"
                android:layout_width="130dp"
                android:layout_height="wrap_content"
                android:text="Right ▶" />
        </LinearLayout>

        <Button
            android:id="@+id/backButton"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="▼ Back" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Motor direction calibration"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/invertLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Invert left motor" />

        <CheckBox
            android:id="@+id/invertRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Invert right motor" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Speed" />

        <SeekBar
            android:id="@+id/speedBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="50"
            android:progress="22" />

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:text="Log:\n"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
